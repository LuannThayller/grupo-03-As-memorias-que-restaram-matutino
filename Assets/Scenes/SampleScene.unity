      value: 'Eu estava passando pela porta do meu predio e do nada parei aqui '
      objectReference: {fileID: 0}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueLines.Array.data[2].dialogueText
      value: "Voc\xEA precisa recuperar as memorias da sua esposa se n\xE3o ela vai desaparecer para sempre e apenas voc\xEA ira lembra-la"
      objectReference: {fileID: 0}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueLines.Array.data[3].dialogueText
      value: Quem esta falando ?
      objectReference: {fileID: 0}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueLines.Array.data[4].dialogueText
      value: "N\xE3o Importa, Ande procure pelos fragmentos e fuja de tudo que se mexe"
      objectReference: {fileID: 0}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueLines.Array.data[5].dialogueText
      value: Quando Coletar todos os fragmentos Pressione e Segure E para prosseguir
      objectReference: {fileID: 0}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueLines.Array.data[6].dialogueText
