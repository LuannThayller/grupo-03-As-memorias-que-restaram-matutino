--- !u!1001 &944753771
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueManager
      value: 
      objectReference: {fileID: 1256527853}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: startOnSceneLoad
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueLines.Array.data[0].dialogueText
      value: "Oi desculpa sair perguntando assim, mas estou procurando minha esposa voc\xEAs viram ela ?"
      objectReference: {fileID: 0}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueLines.Array.data[1].dialogueText
      value: "Oi Boa tarde, meu nome e Ana o dele e Jo\xE3o e ela Aurora."
      objectReference: {fileID: 0}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueLines.Array.data[2].dialogueText
      value: pode dar mais detalhes dela ? muitas pessoas passam por aqui
      objectReference: {fileID: 0}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueLines.Array.data[3].dialogueText
      value: Ela tem um cabelo vermelho bem marcante usa normalmente tudo preto mais ou menos to meu tamanho
      objectReference: {fileID: 0}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueLines.Array.data[4].dialogueText
      value: "e alguem com caracteristicas t\xE3o marcante eu teria lembrado, n\xE3o vi ninguem de cabelo vermelho aqui"
      objectReference: {fileID: 0}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueLines.Array.data[5].dialogueText
      value: "Eu recomendo voc\xEA voltar pra casa e ligar para a policia e registrar um boletim de ocorrencia, ficar peranbulando pela cidade n\xE3o vai ajudar muito"
      objectReference: {fileID: 0}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueLines.Array.data[0].characterName
      value: Dante
      objectReference: {fileID: 0}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueLines.Array.data[1].characterName
      value: "Cidad\xF5es"
      objectReference: {fileID: 0}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueLines.Array.data[2].characterName
      value: "Ana, Jo\xE3o e Aurora"
      objectReference: {fileID: 0}
    - target: {fileID: 911603298611836316, guid: e9010595fb8991340b60c089687b8883, type: 3}
      propertyPath: dialogueLines.Array.data[3].characterName
